FROM remnux/remnux-distro:noble

USER root
ENV DEBIAN_FRONTEND=noninteractive

RUN python3 -m venv /opt/maldoc-mcp \
    && /opt/maldoc-mcp/bin/pip install --no-cache-dir "mcp[cli]"

COPY maldoc_mcp_server.py /opt/maldoc_mcp_server.py

RUN mkdir -p /home/remnux/samples \
    && chown -R remnux:remnux /home/remnux/samples /opt/maldoc-mcp

USER remnux
WORKDIR /home/remnux

ENTRYPOINT ["/opt/maldoc-mcp/bin/python", "/opt/maldoc_mcp_server.py"]
