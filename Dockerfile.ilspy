# ==========================================================
# Stage 1: Compile the ILSpy MCP Server from Source (Forced to .NET 8)
# ==========================================================
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Install git and sed so we can grab the source and modify it
RUN apt-get update && apt-get install -y git sed && rm -rf /var/lib/apt/lists/*

# Clone the repository
RUN git clone --depth 1 https://github.com/bivex/ILSpy-Mcp.git .

# Force the project files to target .NET 8.0 instead of .NET 9.0
RUN find . -name "*.csproj" -exec sed -i 's/<TargetFramework>net9.0<\/TargetFramework>/<TargetFramework>net8.0<\/TargetFramework>/g' {} +

# Restore dependencies and compile a self-contained release binary
RUN dotnet restore
RUN dotnet publish -c Release -o /app --no-restore

# ==========================================================
# Stage 2: Lightweight Runtime (Matched on cached .NET 8)
# ==========================================================
FROM mcr.microsoft.com/dotnet/runtime:8.0
WORKDIR /app

# Copy the compiled binaries from Stage 1
COPY --from=build /app .

# Ensure the non-privileged workspace directories exist
RUN mkdir -p /home/remnux/samples /home/remnux/projects

# Set the entry point to run the compiled assembly
ENTRYPOINT ["dotnet", "ILSpy.Mcp.dll"]
